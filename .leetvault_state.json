          "language": "cpp",
          "code": "class Solution {\npublic:\n    int countSeniors(vector<string>& details) {\n        int cnt =0;\n        for( auto s : details){\n            string age = s.substr(11,2);\n            if( stoi(age)>60) cnt++;\n        }\n        return cnt;\n    }\n};",
